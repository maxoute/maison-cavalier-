# Copier en .env sur le serveur de production, renseigner avec les clés
# du projet Supabase Cloud (jamais celles du stack local `supabase start`).

# Dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service-role — accès complet, ne jamais exposer au client (PRD §5)
SUPABASE_SERVICE_ROLE_KEY=

# Rappels « colis non retiré » J+2 : secret attendu par l'ordonnanceur qui
# appelle POST /api/rappels/colis (en-tête « Authorization: Bearer … »).
# Sans valeur, la route refuse tout appel.
CRON_SECRET=

# WhatsApp Business (Meta Cloud API). Les quatre valeurs sont requises
# ensemble : il en manque une et l'application reste en simulation, envois
# comme réception. Le webhook est à déclarer sur /api/whatsapp/webhook.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Optionnel, par défaut v21.0
WHATSAPP_API_VERSION=

# Gemini : triage IA des messages WhatsApp entrants (création de demandes).
# Sans clé, les messages sont reçus normalement mais non analysés.
GEMINI_API_KEY=
# Optionnel, par défaut gemini-3.8-flash
GEMINI_MODEL=

# Adresse publique : base des liens d'invitation et de réinitialisation.
APP_URL=https://app.maison-cavalier.com

# E-mails (invitations, mot de passe oublié, documents syndic) via Resend.
# Domaine maison-cavalier.com à vérifier chez Resend (enregistrements DNS).
# Sans ces deux valeurs, les e-mails restent simulés : l'admin voit le lien
# d'invitation à l'écran et le transmet lui-même.
RESEND_API_KEY=
EMAIL_FROM=Maison Cavalier <noreply@maison-cavalier.com>

# Boutons « Comptes de démonstration » sur la page de connexion (comptes du
# seed). Jamais en production réelle ; le mot de passe n'est lu que si
# DEMO_LOGIN=true.
DEMO_LOGIN=false
DEMO_PASSWORD=

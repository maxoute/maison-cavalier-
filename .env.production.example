# Copier en .env sur le serveur de production, renseigner avec les clés
# du projet Supabase Cloud (jamais celles du stack local `supabase start`).

# Dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service-role — accès complet, ne jamais exposer au client (PRD §5)
SUPABASE_SERVICE_ROLE_KEY=

# Secret de l'ordonnanceur (en-tête « Authorization: Bearer … ») pour :
#   POST /api/rappels/colis      rappels « colis non retiré » J+2 (1×/jour)
#   POST /api/whatsapp/outbox    file des messages WhatsApp automatiques
#                                (toutes les minutes : relance ce qu'une
#                                action n'aurait pas envoyé)
# Sans valeur, ces routes refusent tout appel.
CRON_SECRET=

# WhatsApp Business (Meta Cloud API). Les quatre valeurs sont requises
# ensemble : il en manque une et l'application reste en simulation, envois
# comme réception. Le webhook est à déclarer sur /api/whatsapp/webhook.
# Les messages automatiques (colis, pressing, annonces urgentes,
# recommandations) partent avec les modèles de lib/whatsapp/templates.ts,
# à faire valider dans WhatsApp Manager sous les mêmes noms (langue fr).
# APP_SECRET : celui de l'app Meta dont le webhook pointe vers ce serveur.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Optionnel, par défaut v21.0
WHATSAPP_API_VERSION=

# Gemini : triage IA des messages WhatsApp entrants (création de demandes).
# Sans clé, les messages sont reçus normalement mais non analysés.
GEMINI_API_KEY=
# Optionnel, par défaut gemini-3.8-flash
GEMINI_MODEL=
